<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Mona Mayhem - GitHub Contribution Battle Arena</title>
		<!-- Google Fonts for Press Start 2P -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
		<style>
			/* CRT Scanline Background Effect */
			.crt-overlay {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				pointer-events: none;
				background:
					/* Scanlines */
					repeating-linear-gradient(
						0deg,
						transparent,
						transparent 2px,
						rgba(0, 255, 0, 0.03) 2px,
						rgba(0, 255, 0, 0.03) 4px
					),
					/* Vignette effect */
					radial-gradient(
						ellipse at center,
						transparent 60%,
						rgba(0, 0, 0, 0.3) 100%
					);
				z-index: -1;
			}

			/* Flicker animation for CRT effect */
			@keyframes crt-flicker {
				0%, 100% { opacity: 1; }
				2% { opacity: 0.98; }
				4% { opacity: 1; }
				8% { opacity: 0.99; }
				10% { opacity: 1; }
				12% { opacity: 0.98; }
				14% { opacity: 1; }
			}

			/* Base retro arcade styling */
			* {
				font-family: 'Press Start 2P', monospace;
			}

			body {
				background: #0a0a1a;
				color: #5fed83;
				margin: 0;
				padding: 20px;
				min-height: 100vh;
				position: relative;
				animation: crt-flicker 8s infinite;
			}

			.arena-container {
				max-width: 1200px;
				margin: 0 auto;
				position: relative;
				z-index: 1;
			}

			/* Neon Title with Pulsing Glow */
			h1 {
				text-align: center;
				color: #5fed83;
				font-size: 1.8em;
				text-shadow:
					0 0 5px #5fed83,
					0 0 10px #5fed83,
					0 0 15px #5fed83,
					0 0 20px #5fed83;
				animation: neon-pulse 2s ease-in-out infinite alternate;
				margin-bottom: 30px;
				letter-spacing: 2px;
			}

			@keyframes neon-pulse {
				0% {
					text-shadow:
						0 0 5px #5fed83,
						0 0 10px #5fed83,
						0 0 15px #5fed83,
						0 0 20px #5fed83;
				}
				50% {
					text-shadow:
						0 0 10px #8a2be2,
						0 0 20px #8a2be2,
						0 0 30px #8a2be2,
						0 0 40px #8a2be2;
				}
				100% {
					text-shadow:
						0 0 5px #5fed83,
						0 0 10px #5fed83,
						0 0 15px #5fed83,
						0 0 20px #5fed83;
				}
			}

			/* Battle Section with Retro Borders */
			.battle-section {
				background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
				border: 4px solid #5fed83;
				border-radius: 0; /* Sharp corners for retro feel */
				padding: 30px;
				margin-bottom: 20px;
				position: relative;
				box-shadow:
					inset 0 0 20px rgba(95, 237, 131, 0.1),
					0 0 20px rgba(95, 237, 131, 0.2);
			}

			.battle-section::before {
				content: '';
				position: absolute;
				top: -4px;
				left: -4px;
				right: -4px;
				bottom: -4px;
				background: linear-gradient(45deg, #5fed83, #8a2be2, #5fed83);
				z-index: -1;
				animation: border-glow 3s ease-in-out infinite;
			}

			@keyframes border-glow {
				0%, 100% { opacity: 0.5; }
				50% { opacity: 1; }
			}

			/* Input Fields with Float-in Animation */
			.player-inputs {
				display: flex;
				gap: 30px;
				margin-bottom: 30px;
			}

			.player-input {
				flex: 1;
				animation: float-in 0.8s ease-out;
			}

			.player-input:nth-child(1) {
				animation-delay: 0.2s;
			}

			.player-input:nth-child(2) {
				animation-delay: 0.4s;
			}

			@keyframes float-in {
				0% {
					transform: translateY(50px);
					opacity: 0;
				}
				100% {
					transform: translateY(0);
					opacity: 1;
				}
			}

			.player-input label {
				display: block;
				margin-bottom: 10px;
				font-size: 0.8em;
				color: #8a2be2;
				text-shadow: 0 0 5px #8a2be2;
			}

			.player-input input {
				width: 100%;
				padding: 15px;
				font-size: 0.7em;
				border: 3px solid #5fed83;
				border-radius: 0;
				background: #0a0a1a;
				color: #5fed83;
				box-shadow:
					inset 0 0 10px rgba(95, 237, 131, 0.2),
					0 0 10px rgba(95, 237, 131, 0.3);
				transition: all 0.3s ease;
			}

			.player-input input:focus {
				outline: none;
				border-color: #8a2be2;
				box-shadow:
					inset 0 0 15px rgba(138, 43, 226, 0.3),
					0 0 20px rgba(138, 43, 226, 0.5);
			}

			/* Retro Arcade Button */
			#battle-button {
				background: linear-gradient(135deg, #5fed83 0%, #4ade80 100%);
				color: #0a0a1a;
				border: 4px solid #5fed83;
				border-radius: 0;
				padding: 20px 40px;
				font-size: 0.8em;
				cursor: pointer;
				font-family: 'Press Start 2P', monospace;
				font-weight: normal;
				text-transform: uppercase;
				letter-spacing: 2px;
				position: relative;
				transition: all 0.2s ease;
				box-shadow:
					inset 0 0 20px rgba(95, 237, 131, 0.3),
					0 0 15px rgba(95, 237, 131, 0.4);
			}

			#battle-button:hover:not(:disabled) {
				background: linear-gradient(135deg, #8a2be2 0%, #7b2cbf 100%);
				border-color: #8a2be2;
				box-shadow:
					inset 0 0 25px rgba(138, 43, 226, 0.4),
					0 0 25px rgba(138, 43, 226, 0.6);
				transform: translateY(-2px);
			}

			#battle-button:active:not(:disabled) {
				transform: translateY(0);
				box-shadow:
					inset 0 0 30px rgba(138, 43, 226, 0.5),
					0 0 10px rgba(138, 43, 226, 0.3);
			}

			#battle-button:disabled {
				background: #333;
				border-color: #666;
				cursor: not-allowed;
				box-shadow: none;
				color: #666;
			}

			/* Loading Text with Color Shifting */
			.loading {
				text-align: center;
				font-size: 0.8em;
				color: #5fed83;
				text-shadow: 0 0 10px #5fed83;
				animation: color-shift 1.5s ease-in-out infinite;
			}

			@keyframes color-shift {
				0%, 100% {
					color: #5fed83;
					text-shadow: 0 0 10px #5fed83, 0 0 20px #5fed83;
				}
				50% {
					color: #8a2be2;
					text-shadow: 0 0 10px #8a2be2, 0 0 20px #8a2be2;
				}
			}

			/* Error Message Styling */
			.error-message {
				background: linear-gradient(135deg, #8a2be2 0%, #7b2cbf 100%);
				color: white;
				padding: 20px;
				border-radius: 0;
				text-align: center;
				font-size: 0.7em;
				font-weight: normal;
				border: 3px solid #8a2be2;
				box-shadow:
					inset 0 0 20px rgba(138, 43, 226, 0.3),
					0 0 15px rgba(138, 43, 226, 0.4);
				margin-top: 15px;
			}

			/* Results Section */
			.results-section {
				display: none;
			}

			.results-section h2 {
				text-align: center;
				color: #8a2be2;
				font-size: 1.2em;
				text-shadow: 0 0 10px #8a2be2;
				margin-bottom: 30px;
			}

			/* Battle Results Layout */
			.battle-results {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				gap: 30px;
				margin-top: 30px;
			}

			/* Player Result Cards with Shine Effect */
			.player-result {
				flex: 1;
				text-align: center;
				padding: 25px;
				background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
				border: 3px solid #5fed83;
				border-radius: 0;
				position: relative;
				overflow: hidden;
				box-shadow:
					inset 0 0 20px rgba(95, 237, 131, 0.1),
					0 0 15px rgba(95, 237, 131, 0.3);
			}

			.player-result::before {
				content: '';
				position: absolute;
				top: 0;
				left: -100%;
				width: 100%;
				height: 100%;
				background: linear-gradient(
					90deg,
					transparent,
					rgba(95, 237, 131, 0.4),
					transparent
				);
				animation: shine 3s ease-in-out infinite;
			}

			@keyframes shine {
				0% { left: -100%; }
				50% { left: 100%; }
				100% { left: 100%; }
			}

			.player-result h3 {
				margin-top: 0;
				color: #5fed83;
				font-size: 0.8em;
				text-shadow: 0 0 5px #5fed83;
			}

			.player-result p {
				margin: 10px 0;
				font-size: 0.6em;
				color: #8a2be2;
			}

			.date-range {
				color: #666;
				font-size: 0.5em;
				margin: 5px 0 15px 0;
			}

			/* VS Section with Animated Badge */
			.vs-section {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				min-width: 140px;
				padding: 30px;
			}

			.vs-badge {
				font-size: 1.5em;
				font-weight: normal;
				color: #0a0a1a;
				background: radial-gradient(circle, #5fed83, #8a2be2);
				border: 4px solid #5fed83;
				border-radius: 50%;
				width: 80px;
				height: 80px;
				display: flex;
				align-items: center;
				justify-content: center;
				margin-bottom: 15px;
				animation: gradient-shift 2s ease-in-out infinite, pulse-scale 3s ease-in-out infinite;
				box-shadow:
					0 0 20px rgba(95, 237, 131, 0.5),
					0 0 40px rgba(138, 43, 226, 0.3);
			}

			@keyframes gradient-shift {
				0% { background: radial-gradient(circle, #5fed83, #8a2be2); }
				33% { background: radial-gradient(circle, #8a2be2, #5fed83); }
				66% { background: radial-gradient(circle, #5fed83, #8a2be2); }
				100% { background: radial-gradient(circle, #5fed83, #8a2be2); }
			}

			@keyframes pulse-scale {
				0%, 100% { transform: scale(1); }
				50% { transform: scale(1.05); }
			}

			.winner-announcement {
				text-align: center;
				font-size: 0.6em;
				color: #ffff00;
				text-shadow: 0 0 10px #ffff00;
				font-weight: normal;
			}

			/* Contribution Grid with Enhanced Hover Effects */
			.contribution-graph {
				display: flex;
				flex-direction: column;
				gap: 3px;
				justify-content: center;
				margin-top: 20px;
			}

			.contribution-row {
				display: flex;
				gap: 3px;
			}

			.contribution-day {
				width: 12px;
				height: 12px;
				border-radius: 0;
				border: 1px solid rgba(95, 237, 131, 0.3);
				transition: all 0.2s ease;
				cursor: pointer;
			}

			.contribution-day:hover {
				transform: scale(1.2);
				box-shadow:
					0 0 8px rgba(95, 237, 131, 0.8),
					0 0 16px rgba(138, 43, 226, 0.6);
				z-index: 10;
			}

			/* Responsive Design */
			@media (max-width: 768px) {
				.player-inputs {
					flex-direction: column;
					gap: 20px;
				}

				.battle-results {
					flex-direction: column;
					gap: 20px;
				}

				.vs-section {
					min-width: auto;
					padding: 20px;
				}

				h1 {
					font-size: 1.2em;
				}

				.battle-section {
					padding: 20px;
				}
			}
		</style>
	</head>
	<body>
		<!-- CRT Scanline Overlay -->
		<div class="crt-overlay"></div>
		<div class="arena-container">
			<h1>Mona Mayhem - GitHub Contribution Battle Arena</h1>

			<div class="battle-section">
				<!-- Battle form will go here -->
				<div id="battle-form">
					<h2>Enter Player Usernames</h2>
					<div class="player-inputs">
						<div class="player-input">
							<label for="player1">Player 1:</label>
							<input type="text" id="player1" placeholder="GitHub username" />
						</div>
						<div class="player-input">
							<label for="player2">Player 2:</label>
							<input type="text" id="player2" placeholder="GitHub username" />
						</div>
					</div>
					<button id="battle-button" disabled>Battle!</button>
				</div>

				<div id="loading" class="loading" style="display: none;">
					Loading battle data...
				</div>

				<div id="error-message" class="error-message" style="display: none;">
					<!-- Error messages will be displayed here -->
				</div>
			</div>

			<div class="results-section" id="results-section">
				<!-- Results display will go here -->
				<h2>Battle Results</h2>
				<div id="results-display">
					<!-- Results will be populated by JavaScript -->
				</div>
			</div>
		</div>

		<script>
			// TypeScript interfaces for contribution data
			interface ContributionDay {
				date: string;
				count: number;
				level: number;
			}

			interface ContributionData {
				username: string;
				total: number;
				contributions: ContributionDay[];
			}

			// DOM elements
			const player1Input = document.getElementById('player1') as HTMLInputElement;
			const player2Input = document.getElementById('player2') as HTMLInputElement;
			const battleButton = document.getElementById('battle-button') as HTMLButtonElement;
			const battleForm = document.getElementById('battle-form') as HTMLDivElement;
			const loadingDiv = document.getElementById('loading') as HTMLDivElement;
			const resultsSection = document.getElementById('results-section') as HTMLDivElement;
			const resultsDisplay = document.getElementById('results-display') as HTMLDivElement;
			const errorMessageDiv = document.getElementById('error-message') as HTMLDivElement;

			// Validate inputs and enable/disable battle button
			function validateInputs(): void {
				const p1 = player1Input.value.trim();
				const p2 = player2Input.value.trim();
				battleButton.disabled = !p1 || !p2;
			}

			// Input event listeners
			player1Input.addEventListener('input', validateInputs);
			player2Input.addEventListener('input', validateInputs);

			// Enter key support
			player1Input.addEventListener('keypress', (e) => {
				if (e.key === 'Enter' && !battleButton.disabled) {
					startBattle();
				}
			});

			player2Input.addEventListener('keypress', (e) => {
				if (e.key === 'Enter' && !battleButton.disabled) {
					startBattle();
				}
			});

			// Battle button click handler
			battleButton.addEventListener('click', startBattle);

			async function startBattle(): Promise<void> {
				const player1 = player1Input.value.trim();
				const player2 = player2Input.value.trim();

				// Additional validation
				if (!player1 || !player2) {
					showError('Please enter both usernames');
					return;
				}

				// Show loading state
				battleForm.style.display = 'none';
				loadingDiv.style.display = 'block';
				resultsSection.style.display = 'none';
				errorMessageDiv.style.display = 'none';

				try {
					// Fetch both users' data in parallel
					const [data1, data2] = await Promise.all([
						fetchContributionData(player1),
						fetchContributionData(player2)
					]);

					// Hide loading, show results
					loadingDiv.style.display = 'none';
					resultsSection.style.display = 'block';

					// Display battle results
					displayBattleResults(data1, data2);

				} catch (error) {
					console.error('Battle failed:', error);
					showError('Failed to load contribution data. Please try again.');
				}
			}

			async function fetchContributionData(username: string): Promise<ContributionData> {
				const response = await fetch(`/api/contributions/${username}`);
				if (!response.ok) {
					const error = await response.json();
					throw new Error(error.error || `Failed to fetch data for ${username}`);
				}
				return response.json();
			}

			function displayBattleResults(data1: ContributionData, data2: ContributionData): void {
				// Determine winner
				const winner = data1.total > data2.total ? data1.username :
							   data2.total > data1.total ? data2.username : 'Draw';

				// Get date range (first and last contribution dates)
				const dateRange1 = getDateRange(data1.contributions);
				const dateRange2 = getDateRange(data2.contributions);

				resultsDisplay.innerHTML = `
					<div class="battle-results">
						<div class="player-result">
							<h3>${data1.username}</h3>
							<p><strong>${data1.total.toLocaleString()}</strong> contributions</p>
							<p class="date-range">${dateRange1}</p>
							<div class="contribution-graph">
								${generateContributionGraph(data1.contributions)}
							</div>
						</div>

						<div class="vs-section">
							<div class="vs-badge">VS</div>
							<div class="winner-announcement">
								<strong>Winner: ${winner}</strong>
							</div>
						</div>

						<div class="player-result">
							<h3>${data2.username}</h3>
							<p><strong>${data2.total.toLocaleString()}</strong> contributions</p>
							<p class="date-range">${dateRange2}</p>
							<div class="contribution-graph">
								${generateContributionGraph(data2.contributions)}
							</div>
						</div>
					</div>
				`;
			}

			function getDateRange(contributions: ContributionDay[]): string {
				if (contributions.length === 0) return 'No data';

				const dates = contributions.map(c => new Date(c.date));
				const earliest = new Date(Math.min(...dates.map(d => d.getTime())));
				const latest = new Date(Math.max(...dates.map(d => d.getTime())));

				return `${earliest.toLocaleDateString()} - ${latest.toLocaleDateString()}`;
			}

			function generateContributionGraph(contributions: ContributionDay[]): string {
				// Create a 7x53 grid (7 days of week x 53 weeks = 371 cells)
				// This matches GitHub's contribution calendar layout
				const grid: (ContributionDay | null)[][] = [];
				for (let i = 0; i < 7; i++) {
					grid[i] = new Array(53).fill(null);
				}

				// Sort contributions by date
				const sortedContributions = [...contributions].sort((a, b) =>
					new Date(a.date).getTime() - new Date(b.date).getTime()
				);

				// Place contributions in the grid
				// Start from the most recent Sunday and work backwards
				const today = new Date();
				const startOfWeek = new Date(today);
				startOfWeek.setDate(today.getDate() - today.getDay()); // Start of current week (Sunday)

				for (let week = 52; week >= 0; week--) {
					for (let day = 0; day < 7; day++) {
						const date = new Date(startOfWeek);
						date.setDate(startOfWeek.getDate() - (week * 7) - (6 - day)); // Work backwards

						const dateStr = date.toISOString().split('T')[0];
						const contribution = sortedContributions.find(c => c.date === dateStr);

						if (contribution) {
							grid[day][week] = contribution;
						}
					}
				}

				// Generate HTML for the grid
				const colors = ['#ebedf0', '#9be9a8', '#40c463', '#30a14e', '#216e39'];

				let html = '';
				for (let row = 0; row < 7; row++) {
					html += '<div class="contribution-row">';
					for (let col = 0; col < 53; col++) {
						const contribution = grid[row][col];
						const color = contribution ? colors[contribution.level] || colors[0] : colors[0];
						const title = contribution
							? `${contribution.date}: ${contribution.count} contributions`
							: 'No contributions';

						html += `<div class="contribution-day" style="background-color: ${color};" title="${title}"></div>`;
					}
					html += '</div>';
				}

				return html;
			}

			function showError(message: string): void {
				battleForm.style.display = 'block';
				loadingDiv.style.display = 'none';
				resultsSection.style.display = 'none';
				errorMessageDiv.style.display = 'block';
				errorMessageDiv.textContent = message;
			}
		</script>

		<style>
			.player-inputs {
				display: flex;
				gap: 20px;
				margin-bottom: 20px;
			}

			.player-input {
				flex: 1;
			}

			.player-input label {
				display: block;
				margin-bottom: 5px;
				font-weight: bold;
			}

			.player-input input {
				width: 100%;
				padding: 10px;
				font-size: 16px;
				border: 2px solid #ff6b35;
				border-radius: 5px;
				background: #1a1a1a;
				color: #00ff00;
			}

			#battle-button {
				background: #ff6b35;
				color: white;
				border: none;
				padding: 15px 30px;
				font-size: 18px;
				border-radius: 5px;
				cursor: pointer;
				font-family: 'Courier New', monospace;
				font-weight: bold;
			}

			#battle-button:disabled {
				background: #666;
				cursor: not-allowed;
			}

			#battle-button:hover:not(:disabled) {
				background: #ff5722;
			}

			.battle-results {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				gap: 20px;
				margin-top: 20px;
			}

			.player-result {
				flex: 1;
				text-align: center;
				padding: 20px;
				background: #2a2a2a;
				border-radius: 10px;
				border: 2px solid #ff6b35;
			}

			.player-result h3 {
				margin-top: 0;
				color: #ff6b35;
			}

